# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (e.g. mongodb://localhost:27017/classpoll-plus or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/classpoll-plus

# JWT Configuration (Use separate 256-bit cryptographically random strings, minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_replace_with_random_hex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_replace_with_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies Configuration (Set COOKIE_SECURE=true and COOKIE_SAME_SITE=none in production over HTTPS when using cross-domain frontend/backend)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin Initial Seed Credentials
# Used only by 'npm run seed:admin'. Rotate or remove from .env after initial setup.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_min_8_chars_with_upper_and_number

